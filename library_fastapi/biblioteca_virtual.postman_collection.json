              "status": "Not Found",
              "code": 404,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"detail\": \"Livro não encontrado\"\n}",
              "originalRequest": {
                "method": "DELETE",
                "url": { "raw": "{{base_url}}/books/9999", "host": ["{{base_url}}"], "path": ["books", "9999"] }
              }
            },
            {
              "name": "422 Unprocessable Entity - ID não numérico",
              "status": "Unprocessable Entity",
              "code": 422,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"detail\": [\n    {\n      \"type\": \"int_parsing\",\n      \"loc\": [\"path\", \"book_id\"],\n      \"msg\": \"Input should be a valid integer, unable to parse string as an integer\",\n      \"input\": \"abc\"\n    }\n  ]\n}",
              "originalRequest": {
                "method": "DELETE",
                "url": { "raw": "{{base_url}}/books/abc", "host": ["{{base_url}}"], "path": ["books", "abc"] }
              }
            },
            {
              "name": "500 Internal Server Error",
              "status": "Internal Server Error",
              "code": 500,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
