                "exec": [
                  "pm.test('Status 422 (token limit) ou 200 (abaixo do limite)', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 422]);",
                  "});",
                  "pm.test('Se 422, retorna mensagem de limite de tokens', () => {",
                  "  if (pm.response.code === 422) {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('error');",
                  "    pm.expect(body.error).to.include('tokens');",
                  "  }",
                  "});"
                ]
