# Obrigatório — chave da OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sua-chave-aqui

# Opcional — LangSmith tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=sua-chave-langsmith
# LANGCHAIN_PROJECT=chatbot_python

# SSL — use em redes corporativas com proxy/VPN que faz inspeção SSL
# Opção 1: desabilitar verificação (somente desenvolvimento)
# SSL_VERIFY=false
# Opção 2: apontar para o certificado da empresa (recomendado)
# SSL_CERT_FILE=C:/caminho/para/certificado-corporativo.pem
