# Ollama — embeddings locais, sem custo
# Certifique-se de que o Ollama está rodando: https://ollama.com
# e que o modelo foi baixado: ollama pull nomic-embed-text
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# FAISS — caminhos dos arquivos de índice (opcional, padrão na raiz do projeto)
# FAISS_INDEX_PATH=./blog_index.faiss
# FAISS_META_PATH=./blog_meta.json
